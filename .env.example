# Необязательно. Если не задать, секрет сгенерируется сам в data/.jwt-secret
JWT_SECRET=
PORT=3000

# Email-адреса администраторов через запятую — им становится доступна /#/admin
ADMIN_EMAILS=admin@example.com

# Поднятие объявления в топ (оплата подтверждается вручную в админке)
PROMOTE_PRICE=1000
PROMOTE_CURRENCY=AMD
PROMOTE_DAYS=7
# Текст с реквизитами для оплаты, который увидит пользователь (номер карты/Idram/Telcell)
PAYMENT_INSTRUCTIONS=Idram/Telcell: +374 XX XXX XXX

# Реферальная программа: бонусные дни в топе — приглашающему и новому
# пользователю. Начисляются только после первого объявления приглашённого.
REF_BONUS_REFERRER_DAYS=7
REF_BONUS_NEWUSER_DAYS=3

# Бесплатный лимит активных объявлений на пользователя; платные тарифы для
# дилеров (см. /#/packages) его поднимают — оплата тоже подтверждается вручную
FREE_LISTING_LIMIT=3
PACKAGE_CURRENCY=AMD

# Через сколько дней без изменений объявление считается «залежавшимся»
# и получает подсказку «обновите фото» / «поднимите в топ»
STALE_LISTING_DAYS=21

# Домен для ссылок в sitemap.xml, robots.txt и /l/:id (og:url).
# Если не задать — берётся из заголовков входящего запроса
SITE_ORIGIN=
